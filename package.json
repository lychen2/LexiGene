{
  "name": "lexigene",
  "version": "0.1.1",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/lychen2/LexiGene.git" },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/run-go.mjs tool mygo dev",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build && vite build --ssr src/entry-server.tsx --outDir artifacts/prerender && node tools/prerender.mjs",
    "build": "node tools/run-go.mjs tool mygo build",
    "build:all": "node tools/run-go.mjs tool mygo build -platform darwin/universal,windows/amd64,linux/amd64",
    "build:android": "node tools/build-android.mjs",
    "start": "node tools/run-go.mjs run . --serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:go": "node tools/run-go.mjs test ./...",
    "test:e2e": "npm run build:web && playwright test"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "mygo-runtime": "0.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "anki-apkg-export": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
